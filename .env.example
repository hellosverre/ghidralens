# Where the PyGhidra bridge is listening. Started by `npm run bridge`.
GHIDRALENS_BRIDGE_URL=http://127.0.0.1:8799

# Shared secret. The bridge prints one on startup if this is unset; copy it here.
GHIDRALENS_TOKEN=

# Ghidra 12.x install root (the folder containing ghidraRun and support/).
GHIDRA_INSTALL_DIR=C:\path\to\ghidra_12.1.2_PUBLIC
